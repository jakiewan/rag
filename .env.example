# =============================================================================
# .env.example —— 复制为 .env 后按需填写
# 任何 .env 文件都不要提交到 Git 仓库（已在 .gitignore 中忽略）。
# =============================================================================

# MinerU CLI
# 如果用 pip install magic-pdf 安装，命令行通常是 `mineru`
# 如果用 conda / 源码安装，改为实际可执行文件名
MINERU_BIN=mineru
MINERU_BACKEND=pipeline

# MinIO（对象存储）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-base
MINIO_SECURE=false

# 阿里云百炼（OpenAI 兼容）
# 申请地址: https://bailian.console.aliyun.com/
# 留空将跳过 VLM 摘要，使用占位标题
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-plus
