# =============================================================================
# .env.example —— 复制为 .env 后按需填写（仅本机覆盖用）
# 任何 .env 文件都不要提交到 Git 仓库（已在 .gitignore 中忽略）。
# =============================================================================
# 注意：以下所有变量都有"代码内默认值"，本文件仅用于在 **不修改代码** 的前提下
# 在本机覆盖这些默认值。绝大多数情况下你不需要 .env，直接跑就能工作。

# —— MinerU ——
# 留空时脚本自动在 PATH 中查找 mineru / magic-pdf
# 仅当你的 mineru 不在 PATH 中才需要填绝对路径，例如：
#   MINERU_BIN=/Users/you/.local/bin/mineru
MINERU_BIN=
MINERU_BACKEND=pipeline

# —— MinIO ——
# 默认连远程 43.143.93.152:9000，凭据已用 Fernet 加密嵌入代码
# 仅当你想切到其他 MinIO（如本地 Docker 起的）时才需要覆盖
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=myuser
# MINIO_SECRET_KEY=mypass
# MINIO_BUCKET=my-bucket
# MINIO_SECURE=false

# —— VLM 提供方（按优先级自动选择，第一个有 key 的会被使用）——
# MiniMax 多模态（推荐，国内端点，默认走 MiniMax-M3）
# 留空则跳过 MiniMax；脚本会自动用环境变量 MINIMAX_API_KEY
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 阿里云百炼（OpenAI 兼容，MiniMax 不可用时兜底）
# 申请地址: https://bailian.console.aliyun.com/
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VL_MODEL=qwen-vl-plus

# 两个都没配时 VLM 步骤会用占位标题，主流程仍可走通
